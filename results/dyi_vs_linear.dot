graph "v_dyi_vs_linear" {
  labelloc="t"; label="v_dyi vs linear fit through (499, 440) and (3512, 2850)";
  layout=neato;
  splines=line;
  node [shape=point, width=0.06];

  // axes
  ax_o [width=0.01, style=invis, pos="0,0!"];
