  ax_y [width=0.01, style=invis, pos="0,8.500!"];
  ax_o -- ax_x [color=black, penwidth=1];
  ax_o -- ax_y [color=black, penwidth=1];
  x_lbl [shape=plaintext, label="raw ADC value (12-bit)", pos="4.550,-0.7!"];
  y_lbl [shape=plaintext, label="voltage, mV", pos="-1.1,4.250!"];
  xt_0 [shape=plaintext, fontsize=10, label="0", pos="0.000,-0.3!"];
  xt_1000 [shape=plaintext, fontsize=10, label="1000", pos="2.222,-0.3!"];
  xt_2000 [shape=plaintext, fontsize=10, label="2000", pos="4.444,-0.3!"];
  xt_3000 [shape=plaintext, fontsize=10, label="3000", pos="6.667,-0.3!"];
  xt_4095 [shape=plaintext, fontsize=10, label="4095", pos="9.100,-0.3!"];
  yt_1000 [shape=plaintext, fontsize=10, label="1000", pos="-0.4,2.500!"];
  yt_2000 [shape=plaintext, fontsize=10, label="2000", pos="-0.4,5.000!"];
  yt_3000 [shape=plaintext, fontsize=10, label="3000", pos="-0.4,7.500!"];
  yt_3400 [shape=plaintext, fontsize=10, label="3400", pos="-0.4,8.500!"];

  // legend
  lg_dyi_a [width=0.01, color="#dc2626", pos="0.5,7.600!"];
  lg_dyi_b [width=0.01, color="#dc2626", pos="1.1,7.600!"];
  lg_dyi_a -- lg_dyi_b [color="#dc2626", penwidth=2, style=solid];
  lg_dyi_t [shape=plaintext, fontsize=11, label="v_dyi: handmade calibration (piecewise linear)", pos="3.090,7.600!"];
  lg_lin_a [width=0.01, color="#16a34a", pos="0.5,7.200!"];
  lg_lin_b [width=0.01, color="#16a34a", pos="1.1,7.200!"];
  lg_lin_a -- lg_lin_b [color="#16a34a", penwidth=2, style=dashed];
  lg_lin_t [shape=plaintext, fontsize=11, label="linear: v = 0.7999 * raw + 40.9", pos="2.490,7.200!"];

